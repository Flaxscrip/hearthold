# Agency Warden on flaxlap — custodian of KB "agency" (David's sealed corpus).
# flaxlap paths confirmed by Aegis. See deploy/agentic/INSTALL-agentic.md (and its ⛔ never-rotate rail).
[Unit]
Description=Hearthold Agency Warden — custodian of KB "agency" (David's corpus; private, holds the sealed vault)
Documentation=file:/home/flaxscrip/hearthold/deploy/agentic/INSTALL-agentic.md
After=network-online.target docker.service
Wants=network-online.target
# Reaches the LOCAL Archon node on flaxlap (Drawbridge :4222). Reasoning is via megaflax:11434 over the tailnet.
# ⚠️ `After=docker.service` is NOT enough: docker being up ≠ the gatekeeper CONTAINER being ready, so this
#    Warden could start into a not-yet-ready node. Once the boot-time `docker compose up -d` systemd unit
#    exists (Aegis; it replays the health-gated compose graph), add it here:
#        After=<archon-stack-up>.service
#        Requires=<archon-stack-up>.service
#    so the Warden never starts into a dead/half-ready gatekeeper. See INSTALL-agentic.md "Restart policies".

[Service]
Type=simple
User=flaxscrip
Group=flaxscrip
WorkingDirectory=/home/flaxscrip/hearthold
# 0600 secrets + config: HEARTHOLD_PASSPHRASE, HEARTHOLD_DATA_ROOT=/home/flaxscrip/.hearthold-agentic-warden,
#   HEARTHOLD_REGISTRY=local  (flaxlap accepts local — access-control born local, no gossip/stall),
#   HEARTHOLD_EPHEMERAL_REGISTRY=hyperswarm  (REQUIRED for member login from other nodes: the login challenge
#       must be publicly resolvable, and a `local` challenge is not — see INSTALL-agentic.md "Member login"),
#   HEARTHOLD_NODE_URL=http://localhost:4222, HEARTHOLD_OLLAMA_URL=http://megaflax:11434,
#   HEARTHOLD_ANSWER_MODEL=qwen3:8b
EnvironmentFile=/home/flaxscrip/hearthold/.env.agentic-warden
ExecStart=/home/flaxscrip/.nvm/versions/node/v22.15.1/bin/node /home/flaxscrip/hearthold/packages/warden/dist/index.js serve
# Restart=always (NOT on-failure): a long-running Hearthold daemon that exits cleanly (status 0) must still
# come back — on-failure leaves a clean exit dead forever. Verify self-heal by KILLING it, not by reading this.
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# Isolation: writes ONLY its own data root (the sealed agency vault).
# ⛔ NEVER run `warden rotate` against this identity — it silently orphans the sealed corpus.
#    Recovery (if it happens): revert the DID doc's key with the post-rotation wallet, NOT a file restore.
#    See the SAFETY RAIL in INSTALL-agentic.md.
ReadWritePaths=/home/flaxscrip/.hearthold-agentic-warden

[Install]
WantedBy=multi-user.target
