#!/usr/bin/env bash
# aegis-wallet — run the Keymaster CLI against a node wallet WITHOUT exposing the private gatekeeper.
#
# THE POINT: the gatekeeper lives on the sealed (internal:true) node network and is never published to the
# host. To do wallet work that needs it (resolve/sign/backup/challenge-response), we DON'T open the port —
# we run keymaster in an EPHEMERAL container that joins the sealed net for the command's lifetime and exits.
# Same shape as `docker compose exec gatekeeper …`: admin access via a container, not a host port.
#
# This is the ADMIN counterpart to the `aegis` operator CLI (which is client-only and deliberately never
# joins the node network). Wallet ops legitimately need the gatekeeper, so they get a scoped in-network run.
#
#   aegis-wallet <member> <keymaster-command> [args...]
#     member: aegis | sevenfold | hearthold   (node-env agent wallets; or a path under the data root)
#   e.g.  aegis-wallet aegis list-ids
#         aegis-wallet sevenfold resolve-id
#         aegis-wallet hearthold decrypt-did <cardDID>
#         aegis-wallet aegis backup-wallet-file /data/backups/aegis.json
#         aegis-wallet aegis help            # full keymaster command list
#
#   Identities are the `node` environment's AGENTS (see ~/aegis-env/node/ENVIRONMENT.md). The Sovereign/Warden
#   are node-managed (in ~/aegis-sovereign-hs/data under HEARTHOLD_PASSPHRASE) — accessed via the node stack,
#   not this family CLI.
set -euo pipefail
SELF=$(basename "$0"); HERE=$(cd "$(dirname "$0")" && pwd)

DATA="${AEGIS_FAMILY_DATA:-$HOME/aegis-env/node/data/identities}"   # node-env identity store (agents/*)
NET="${AEGIS_NET:-aegis_internal}"                       # the sealed node network
IMAGE="${AEGIS_KM_IMAGE:-hearthold:sandbox}"             # image carrying the keymaster CLI
GK="${AEGIS_GATEKEEPER_URL:-http://gatekeeper:4224}"     # in-network gatekeeper (never a host port)
REG="${ARCHON_DEFAULT_REGISTRY:-local}"
FAMENV="$HERE/../family/family.env"

usage() { sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
[ $# -lt 1 ] && usage 1
[ "$1" = -h ] || [ "$1" = --help ] && usage 0
[ $# -lt 2 ] && { echo "$SELF: need <member> and a keymaster command" >&2; usage 1; }
member="$1"; shift

case "$member" in
  aegis)           rel='agents/aegis/sovereign/wallet.json' ;;
  sevenfold)       rel='agents/sevenfold/sovereign/wallet.json' ;;
  hearthold)       rel='agents/hearthold/sovereign/wallet.json' ;;
  parent|flaxscrip|sovereign|warden)
    echo "$SELF: '$member' is a node-managed identity, not an agent wallet — see ~/aegis-env/node/ENVIRONMENT.md" >&2
    echo "$SELF: (Sovereign/Warden live in ~/aegis-sovereign-hs/data under HEARTHOLD_PASSPHRASE; use the node stack)" >&2
    exit 1 ;;
  */*)             rel="$member" ;;                       # raw path under the data root
  *) echo "$SELF: unknown member '$member' (aegis|sevenfold|hearthold or a path)" >&2; exit 1 ;;
esac
[ -f "$DATA/$rel" ] || { echo "$SELF: no wallet at $DATA/$rel" >&2; exit 1; }

# Guard: only ever join a SEALED network — never operate against an egress-capable one.
[ "$(docker network inspect "$NET" --format '{{.Internal}}' 2>/dev/null)" = true ] || {
  echo "$SELF: REFUSING — network '$NET' is not internal:true; wallet access stays on the sealed net" >&2; exit 1; }

# Assemble a temp env-file (secret stays in a file, never on the command line); shred on exit.
tmpenv=$(mktemp); trap 'shred -u "$tmpenv" 2>/dev/null || rm -f "$tmpenv"' EXIT
{
  echo "ARCHON_GATEKEEPER_URL=$GK"
  echo "ARCHON_WALLET_TYPE=json"
  echo "ARCHON_WALLET_PATH=/data/$rel"
  echo "ARCHON_DEFAULT_REGISTRY=$REG"
  # Precedence: explicit AEGIS_WALLET_PASS → family.env → ambient ARCHON_PASSPHRASE. family.env wins over an
  # ambient ARCHON_PASSPHRASE so a node/MCP passphrase in the shell can't shadow the family wallets' own.
  if [ -n "${AEGIS_WALLET_PASS:-}" ]; then printf 'ARCHON_PASSPHRASE=%s\n' "$AEGIS_WALLET_PASS"
  elif [ -f "$FAMENV" ] && grep -qE '^FAMILY_PASSPHRASE=.' "$FAMENV"; then grep -E '^FAMILY_PASSPHRASE=' "$FAMENV" | sed 's/^FAMILY_PASSPHRASE=/ARCHON_PASSPHRASE=/'
  elif [ -n "${ARCHON_PASSPHRASE:-}" ]; then printf 'ARCHON_PASSPHRASE=%s\n' "$ARCHON_PASSPHRASE"
  else echo "$SELF: no passphrase (set AEGIS_WALLET_PASS or FAMILY_PASSPHRASE in $FAMENV)" >&2; exit 1; fi
} > "$tmpenv"

tty=; [ -t 0 ] && [ -t 1 ] && tty=-t
exec docker run --rm -i $tty --network "$NET" --entrypoint node_modules/.bin/keymaster \
  --env-file "$tmpenv" -v "$DATA:/data" "$IMAGE" "$@"
