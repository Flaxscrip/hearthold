# aegis operator CLI — per-node config. Copy to `aegis.env` (next to the `aegis`
# script) or `~/.aegis.env`, and edit. All values are optional; sensible
# loopback defaults apply. This file is sourced, so use shell syntax.

# --- daemon loopback bridges (host-published; the safe client entry points) ---
# Defaults match the standard control overlay. Override only if you remapped ports.
#AEGIS_WARDEN_URL=http://127.0.0.1:4310
#AEGIS_SIGNET_URL=http://127.0.0.1:4311
#AEGIS_EMISSARY_URL=http://127.0.0.1:4312    # the witness (card creation); shown by `aegis status`
# `aegis status` DID-resolution + egress-proof knobs:
#AEGIS_GATEKEEPER_URL=http://127.0.0.1:14224  # a host-published gatekeeper (verifies the Sovereign resolves)
#AEGIS_PROOF_CONTAINER=                        # pin which internal container runs the egress test

# --- Table ---
# The prebuilt static bundle to serve ON the node (copy it here from your dev box).
#AEGIS_TABLE_DIST=/mnt/gamerflax/flaxscrip/sevenfold-table-dist
# Where the Table SOURCE lives (dev box only; enables `aegis table build`).
#AEGIS_TABLE_SRC=$HOME/Documents/Projects/Sevenfold/apps/table
# The node's Sovereign DID — baked into the build as the pre-login fallback subject.
#AEGIS_SOVEREIGN_DID=did:cid:bagaaiera...t6pibnmda
#AEGIS_TABLE_PORT=5175

# --- Signet TUI ---
# The hearthold image that carries the built TUI (used for the container path).
#AEGIS_IMAGE=hearthold:sandbox
# Optional: a host-extracted TUI bundle for the native (no-docker) path.
# Populate it once with `aegis signet extract`, then point here:
#AEGIS_SIGNET_TUI_JS=$HOME/.aegis/hh-app/packages/signet-tui/dist/index.js

# --- misc ---
#AEGIS_STATE=$HOME/.aegis        # pidfiles, logs, extracted bundles
