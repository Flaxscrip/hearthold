# gamerflax sphere node — env for start-gamerflax.sh. Copy to gamerflax.env (gitignored) and fill in.
#   cp gamerflax.env.example gamerflax.env   # then edit
#
# The ONLY value you must not lose: ARCHON_PROTOCOL — the shared two-member sphere topic. It must be
# BYTE-FOR-BYTE identical to megaflax's. It's a shared secret distributed out-of-band, never committed.

# Shared sphere topic — MUST match megaflax exactly. (megaflax minted it: openssl rand -hex 32)
ARCHON_PROTOCOL=/aegis-sphere/REPLACE_WITH_SHARED_HEX

# Peer's tailnet gatekeeper — on-demand fallback resolution to megaflax.
PEER_GATEKEEPER_URL=http://100.81.183.80:4324

# Compose project name for this node (keeps its containers/volumes namespaced).
PROJECT=sphere-gamer

# amd64 host? Leave 1 to run the arm64-only archetech images under qemu emulation.
# On a native arm64 host set to 0.
EMULATE=1
