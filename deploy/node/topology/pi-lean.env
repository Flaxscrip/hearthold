# pi-lean.env — the 8 GB Sovereign profile deltas. Applied over the node's .env (after setup-node.sh).
# See deploy/PI-LEAN.md for the rationale (drawbridge bundles Lightning+Tor; the didcomm relay is standalone).
# Merge with: while IFS= read -r l; do [ "${l#\#}" = "$l" ] && [ -n "$l" ] && set_env "${l%%=*}" "${l#*=}"; done < pi-lean.env

# Archon node — minimal profile set: identity + card-passing, no drawbridge/lightning/tor/herald.
COMPOSE_PROFILES=cli,didcomm
ARCHON_GATEKEEPER_REGISTRIES=local
ARCHON_DEFAULT_REGISTRY=local
ARCHON_GATEKEEPER_FALLBACK_URL=
ARCHON_GATEKEEPER_CONFIRM_FALLBACK_URL=

# Custodian (hearthold) — DIDComm goes straight to the standalone relay (no drawbridge).
HEARTHOLD_DIDCOMM_ENDPOINT=http://didcomm:4236
HEARTHOLD_REGISTRY=local

# On-device AI — one model at a time (co-loading the vision model is what OOMs an 8 GB box).
OLLAMA_MAX_LOADED_MODELS=1
HEARTHOLD_CLASSIFIER_MODEL=qwen2.5:3b
# HEARTHOLD_VISION_MODEL is intentionally unset in pi-lean (fail-closed to SEALED if a vision model is absent).
