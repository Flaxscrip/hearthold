# AEGIS PRIVATE Gatekeeper profile — the node's OWN DIDs, unique per-node Hyperswarm topic.
# The mediator runs but the topic is unique => no peers => it propagates to nobody (peerless).
# Layer onto the base stack: `docker compose --env-file deploy/topology/private.env up -d`
COMPOSE_PROJECT_NAME=aegis
COMPOSE_PROFILES=cli,didcomm,drawbridge,hyperswarm
ARCHON_GATEKEEPER_REGISTRIES=local,hyperswarm
ARCHON_DEFAULT_REGISTRY=hyperswarm
# UNIQUE per install — mint with: openssl rand -hex 32 (see setup-node.sh). NEVER shared.
ARCHON_PROTOCOL=/aegis-private/<openssl rand -hex 32>
