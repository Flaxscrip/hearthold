# AEGIS SPHERE Gatekeeper profile — one per sphere, SHARED topic with that sphere's members.
# The mediator gossips only the sphere members' DIDs (bounded volume => cost stays near PRIVATE).
# Every member of a sphere sets the SAME ARCHON_PROTOCOL; it is a shared secret among them.
COMPOSE_PROJECT_NAME=aegis
COMPOSE_PROFILES=cli,didcomm,drawbridge,hyperswarm
ARCHON_GATEKEEPER_REGISTRIES=local,hyperswarm
ARCHON_DEFAULT_REGISTRY=hyperswarm
# SHARED among sphere members (distribute out-of-band). Distinct from any PRIVATE topic.
ARCHON_PROTOCOL=/aegis-sphere/<shared-secret-hex>
