# Family roleplay — TEST DATA (persistent demo family in ~/aegis-family/data).
# TEST-ONLY: these open the DEMO Sovereign/agent wallets on the sandbox node. A REAL Sovereign wallet +
# its passphrase live on the human's OWN device, never on the box (see the secrets convention).
#
# Usage: copy to family.env (gitignored), then run the harnesses with it:
#   docker run --rm --network aegis_internal --env-file deploy/family/family.env \
#     -e HEARTHOLD_NODE_URL=http://table-gateway:4299 -e HEARTHOLD_REGISTRY=local \
#     -e HEARTHOLD_DIDCOMM_ENDPOINT=http://drawbridge:4222/didcomm -e HEARTHOLD_DATA_ROOT=/family-data \
#     -v ~/aegis-family/data:/family-data -v $PWD/deploy/family/<harness>.ts:/app/scripts/<harness>.ts:ro \
#     hearthold:sandbox node --experimental-strip-types /app/scripts/<harness>.ts
FAMILY_PASSPHRASE=change-me-a-strong-passphrase
FAMILY_SIGNET_PIN=2468
