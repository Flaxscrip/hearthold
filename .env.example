# Hearthold environment — copy to .env (which is gitignored)

# Wallet passphrase for the local agent. Each agent process reads this to unlock its wallet.
# SECURE DEFAULT for a real deployment: give each agent its OWN passphrase via a per-role override
# (HEARTHOLD_PASSPHRASE_WARDEN / _SOVEREIGN / _EMISSARY / _VERIFIER / _REGISTRY) so a single leaked
# passphrase can't decrypt all four wallets and collapse the PVM separation (custodian ≠ actor ≠ authorizer).
# A per-role value wins over this shared one; the shared value alone is fine for co-located dev.
HEARTHOLD_PASSPHRASE=
# HEARTHOLD_PASSPHRASE_WARDEN=
# HEARTHOLD_PASSPHRASE_SOVEREIGN=
# HEARTHOLD_PASSPHRASE_EMISSARY=
# HEARTHOLD_PASSPHRASE_VERIFIER=
# HEARTHOLD_PASSPHRASE_REGISTRY=

# Archon node (Drawbridge) URL — fronts the gatekeeper API, capabilities, and the DIDComm mount.
# Must be the Drawbridge URL (:4222), not the raw Gatekeeper (:4224).
HEARTHOLD_NODE_URL=http://flaxlap.local:4222

# Anchoring registry — a TOPOLOGY choice (how many gatekeeper nodes must resolve each other), not a
# security-vs-features knob. See docs/DEPLOYMENT.md "Two registry topologies".
#   local (default) — one gatekeeper node all agents share. Writes are plain DB rows: applied immediately,
#     node-local, NEVER gossiped (isolation by construction). The whole e2e suite runs here.
#   hyperswarm      — only when SEPARATE nodes must resolve each other (federation / multi-device delivery,
#     e.g. a card crossing two laptops). Writes QUEUE until processEvents; isolation is then a deployment
#     conjunction (internal:true + no mediator + a UNIQUE random ARCHON_PROTOCOL topic — the shared
#     /ARCHON/v0.8-beta topic is the PUBLIC network). This is L6 / deployment territory.
HEARTHOLD_REGISTRY=local

# Control-plane HTTP (Warden :4310 / Signet :4311 / Emissary :4312). Loopback origins (localhost/127.0.0.1
# on any port) are always allowed; add a DEPLOYED Table's origin(s) here, comma-separated. Never a wildcard.
# HEARTHOLD_CONTROL_ALLOW_ORIGIN=https://table.example
# Bind interface for the control daemons (default 127.0.0.1 = loopback-only, the safe posture).
# HEARTHOLD_CONTROL_HOST=127.0.0.1

# Docker network the agents attach to (docker-compose.hearthold.yml). REQUIRED — no safe default: it must be
# your ISOLATED node's network (internal:true). `archon_default` is the generic name a regular Archon compose
# creates (an EGRESS bridge shared with regular nodes) — naming that connects Hearthold to the public net.
# Set it deliberately (e.g. aegisb_default, or the sandbox's internal-override archon_default).
# HEARTHOLD_DOCKER_NETWORK=

# Root folder for per-agent wallets, vault, and index.
HEARTHOLD_DATA_ROOT=

# ── Emissary (Companion) ──
# The Warden's did:cid — the address the Emissary sends to over DIDComm. Required for `emissary submit`.
HEARTHOLD_WARDEN_DID=

# ── Warden models (local-only, on-device) ──
HEARTHOLD_OLLAMA_URL=http://localhost:11434
# Classifier — labels artefact sensitivity. Default (unset) is qwen2.5:3b, a fast NON-THINKING instruct
# model that runs well on modest hardware (CPU / no GPU passthrough). Reasoning models (qwen3*) burn
# <think> tokens and are far slower per call there. On better hardware, opt up (e.g. qwen3:8b).
HEARTHOLD_CLASSIFIER_MODEL=
# RAG answerer — composes recall answers over retrieved passages. Defaults to the classifier model; set
# this to use a STRONGER model for answer quality while keeping classification fast (different tradeoffs).
HEARTHOLD_ANSWER_MODEL=
# Embedding model for the recall index.
HEARTHOLD_EMBEDDING_MODEL=nomic-embed-text
# Set to 'quarantine' to disable the model and treat everything as SEALED (fail-safe).
HEARTHOLD_CLASSIFIER=

# ── Docker sandbox (docker-compose.hearthold.yml) ──
# For the offline Docker sandbox you only need HEARTHOLD_PASSPHRASE set here — the
# compose file supplies NODE_URL=http://drawbridge:4222, REGISTRY=local, CLASSIFIER=
# quarantine, and DATA_ROOT itself. Copy this file to .env and set a sandbox value:
#   HEARTHOLD_PASSPHRASE=hearthold-sandbox-dev
# See deploy/sandbox/README.md.
