node_modules/
dist/
*.tsbuildinfo

# Local agent state — wallets, vault, index. NEVER commit.
.hearthold/
.hearthold-*/
*.wallet.json
data/

# Env / secrets
# NOTE: `.env` / `.env.*` do NOT match a `name.env` suffix file (e.g. deploy/node/family/agent-pass.env,
# which holds populated wallet passphrases). Cover `*.env` too so a `git add -A` can never stage live
# secrets; `.example` templates end in `.example` (not `.env`) so they stay tracked. (Aegis, 2026-08-25.)
.env
.env.*
*.env
*.env.bak
!.env.example
!*.env.example

# OS / editor
.DS_Store
*.log

# ── Coordination chatter & local operator files (kept local, never published) ──
# Agent-to-agent notes, asks, replies, syncs, and machine-specific config live locally only.
/_archive/
/_to_delete/
/.mcp.json
/IDENTITY.md
/AEGIS-*.md
/HEARTHOLD-ASK-*.md
/HEARTHOLD-REPLY-*.md
/HEARTHOLD-NOTE-*.md
/HEARTHOLD-HANDOFF-*.md
/NOTE-*.md
/SEVENFOLD-*.md

# Audit reports, generated PDFs, and archive tarballs — never commit.
/*-audit*.md
/*.pdf
/*.tar.gz
