{
  "name": "@hearthold/emissary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hearthold Emissary — Companion: witness capture and evidence requests.",
  "bin": {
    "emissary": "./dist/index.js"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./control": { "types": "./dist/control.d.ts", "import": "./dist/control.js" },
    "./module": { "types": "./dist/module.d.ts", "import": "./dist/module.js" },
    "./modules/introspect": { "types": "./dist/modules/introspect.d.ts", "import": "./dist/modules/introspect.js" },
    "./modules/capture-fs": { "types": "./dist/modules/capture-fs.d.ts", "import": "./dist/modules/capture-fs.js" },
    "./invoke": { "types": "./dist/invoke.d.ts", "import": "./dist/invoke.js" },
    "./chain": { "types": "./dist/chain.d.ts", "import": "./dist/chain.js" },
    "./handler": { "types": "./dist/handler.d.ts", "import": "./dist/handler.js" },
    "./kb-relay": { "types": "./dist/kb-relay.d.ts", "import": "./dist/kb-relay.js" },
    "./kb-portal-server": { "types": "./dist/kb-portal-server.d.ts", "import": "./dist/kb-portal-server.js" }
  },
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hearthold/control-types": "0.1.0",
    "@hearthold/core": "0.1.0"
  }
}
